{
  "name": "racco",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.json --noEmit",
    "build": "node scripts/build.mjs",
    "build:web": "node scripts/build.mjs --target check --part web",
    "build:server": "node scripts/build.mjs --target check --part server",
    "daemon:restart": "systemctl --user restart raccod.service",
    "daemon:status": "systemctl --user status --no-pager raccod.service",
    "test": "node --import tsx --test 'src/**/*.test.ts' 'src/**/*.test.tsx'",
    "smoke": "node scripts/smoke.mjs",
    "smoke:codex": "node scripts/smoke-codex.mjs",
    "smoke:codex-bypass": "node scripts/smoke-permissions.mjs",
    "smoke:codex-resume": "node scripts/smoke-codex-resume.mjs",
    "smoke:claude": "RACCO_PROVIDER=claude node scripts/smoke-codex.mjs",
    "smoke:claude-bypass": "RACCO_PROVIDER=claude node scripts/smoke-permissions.mjs",
    "smoke:claude-question": "RACCO_PROVIDER=claude RACCO_INTERACTION=question node scripts/smoke-permissions.mjs",
    "smoke:claude-interrupt": "RACCO_PROVIDER=claude RACCO_INTERACTION=question RACCO_ACTION=interrupt node scripts/smoke-permissions.mjs",
    "smoke:claude-resume": "RACCO_PROVIDER=claude node scripts/smoke-codex-resume.mjs",
    "screenshot:ui": "node scripts/screenshot-ui.mjs",
    "build:check": "node scripts/build.mjs --target check",
    "check:notes": "python3 scripts/agent_notes.py check",
    "check": "node scripts/check.mjs",
    "preview": "node scripts/preview.mjs start",
    "preview:status": "node scripts/preview.mjs status",
    "preview:stop": "node scripts/preview.mjs stop",
    "doctor": "node --import tsx scripts/doctor.mjs",
    "lint": "oxlint src scripts test vite.config.ts playwright.config.ts --deny-warnings",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"test/**/*.{ts,tsx,mjs}\" vite.config.ts playwright.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"test/**/*.{ts,tsx,mjs}\" vite.config.ts playwright.config.ts",
    "test:tools": "node --test \"scripts/**/*.test.mjs\"",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.251",
    "@fastify/compress": "9.2.0",
    "@fastify/static": "10.1.3",
    "@fastify/websocket": "11.3.0",
    "fastify": "5.12.1",
    "highlight.js": "11.12.0",
    "katex": "0.18.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math-extended": "6.1.1",
    "ws": "8.21.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.1",
    "oxlint": "1.83.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
