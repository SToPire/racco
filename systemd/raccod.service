[Unit]
Description=Racco host daemon
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/racco
ExecStartPre=/usr/bin/test -f %h/.local/share/racco/dist/server/index.js
ExecStart=@NODE@ "%h/.local/share/racco/dist/server/index.js"
Restart=on-failure
RestartSec=2s
TimeoutStopSec=30s
KillMode=control-group
UMask=0077
Environment=NODE_ENV=production
Environment=@PATH@
SyslogIdentifier=raccod

[Install]
WantedBy=graphical-session.target
